# Shared passcode the family types once per phone
APP_PASSCODE=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Photo reading (shelf and cover scans). The first one that is set is used:
# 1. Gemini (free, reads small print best) → aistudio.google.com → Get API key
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash)
GEMINI_MODEL=
# 2. Groq (free, weaker at reading) → console.groq.com → API Keys
GROQ_API_KEY=
# Optional: override the Groq vision model
GROQ_MODEL=
# 3. Claude (paid) → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
