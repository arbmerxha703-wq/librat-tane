# Shared passcode the family types once per phone
APP_PASSCODE=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Photo reading (shelf and cover scans). Set ONE of these:
# Groq (free tier) → console.groq.com → API Keys. Used first when set.
GROQ_API_KEY=
# Optional: override the Groq vision model
GROQ_MODEL=
# Claude → console.anthropic.com → API Keys. Used when GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=
